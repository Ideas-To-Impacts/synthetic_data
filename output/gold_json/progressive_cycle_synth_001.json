  "text_sections": {
    "page1_s1": {
      "section_id": "page1_s1",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "To report a claim. Your coverage began on February 1, 2027 at the later of 12:01 a.m. or the effective time shown on your application. This policy period ends on February 1, 2028 at 12:01 a.m.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page1_s2": {
      "section_id": "page1_s2",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Your insurance policy and any policy endorsements contain a full explanation of your coverage. The policy limits shown for a vehicle may not be combined with the limits for the same coverage on another vehicle. The policy contract is form 5979 NY (10/17). The contract is modified by form A135 NY (11/13).",
      "page_range": [
        1
      ],
      "form_number": "A135 NY (11/13)"
    },
    "page1_s3": {
      "section_id": "page1_s3",
      "section_title": "SEE ENCLOSURE FOR SUPPLEMENTAL SPOUSAL LIABILITY INSURANCE NOTICE Supplementary Uninsured/Underinsured Motorist: (SUM)",
      "section_type": "prose",
      "raw_text": "The maximum amount payable under SUM coverage shall be the policy's SUM limits reduced and thus offset by motor vehicle bodily injury liability insurance policy or bond payments received from, or on behalf of, any negligent party involved in the accident, as specified in the SUM endorsement.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page2_s1": {
      "section_id": "page2_s1",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Please review the Rating Information provided in the Required Information Notice, Form 4746, included in this mailing, for a description of discounts which may be available if you qualify.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page2_s2": {
      "section_id": "page2_s2",
      "section_title": "Premium surcharges",
      "section_type": "prose",
      "raw_text": "This policy is not surcharged. Surcharges may be applied in the future as outlined in the Rating Information provided in the Required Information Notice, Form 4746, included in this mailing.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page2_s3": {
      "section_id": "page2_s3",
      "section_title": "Important information about Accessories on your motorcycle/off-road vehicle",
      "section_type": "prose",
      "raw_text": "Coverage for physical damage to your motorcycle/off-road vehicle extends only to the vehicle as it comes from the factory. Accessories added on at the dealership or by an individual, and therefore not provided as original equipment by the manufacturer, are not considered part of the vehicle as delivered from the factory. If you have purchased comprehensive or collision coverage, we provide up to $3000 of accessory coverage at no additional charge to you. Please review the value of the accessories on your vehicle. Should you wish to purchase coverage for more accessories, additional accessory coverage is available at very reasonable rates.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page2_s4": {
      "section_id": "page2_s4",
      "section_title": "Policy tier",
      "section_type": "prose",
      "raw_text": "This policy has been assigned to the Standard C tier.",
      "page_range": [
        2
      ],
      "form_number": null
    }
  },
