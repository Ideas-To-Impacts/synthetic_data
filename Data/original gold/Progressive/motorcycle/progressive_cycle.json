    "page1_s3": {
      "section_id": "page1_s3",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "To report a claim. Your coverage began on August 26, 2025 at the later of 12:01 a.m. or the effective time shown on your application. This policy period ends on August 26, 2026 at 12:01 a.m.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page1_s4": {
      "section_id": "page1_s4",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Your insurance policy and any policy endorsements contain a full explanation of your coverage. The policy limits shown for a vehicle may not be combined with the limits for the same coverage on another vehicle. The policy contract is form 5979 NY (10/17). The contract is modified by form A135 NY (11/13).",
      "page_range": [
        1
      ],
      "form_number": "A135 NY (11/13)"
    },
    "page1_s5": {
      "section_id": "page1_s5",
      "section_title": "SEE ENCLOSURE FOR SUPPLEMENTAL SPOUSAL LIABILITY INSURANCE NOTICE Supplementary Uninsured/Underinsured Motorist: (SUM)",
      "section_type": "prose",
      "raw_text": "The maximum amount payable under SUM coverage shall be the policy's SUM limits reduced and thus offset by motor vehicle bodily injury liability insurance policy or bond payments received from, or on behalf of, any negligent party involved in the accident, as specified in the SUM endorsement.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page2_s1": {
      "section_id": "page2_s1",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "862180906 N TH01498 INS DECPAGE U POLWHITEFONT WAZJDASZX6OVEBSHBSUYRQGSZA0002 RPUID TRACWHITEFONT BDF_SL",
