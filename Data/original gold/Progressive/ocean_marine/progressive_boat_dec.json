      "section_title": null,
      "section_type": "prose",
      "raw_text": "Your insurance policy and any policy endorsements contain a full explanation of your coverage. The policy limits shown for a watercraft may not be combined with the limits for the same coverage on another watercraft. The policy contract is form 2749 NY (06/21).",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page2_s1": {
      "section_id": "page2_s1",
      "section_title": "Important information regarding Coastal Navigation restrictions",
      "section_type": "prose",
      "raw_text": "A coastal navigation limit applies to this policy. Unless you pay a premium for Coastal Navigation Limit coverage, you are not covered for losses that occur more than 75 nautical miles from the coast of the United States or Canada or for losses that occur in any territory or territorial waters of any country other than the United States or Canada.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page2_s2": {
      "section_id": "page2_s2",
      "section_title": "Important information on the watercraft value",
      "section_type": "prose",
      "raw_text": "The watercraft dollar amount that is listed on the declarations page is the amount that you indicated includes the watercraft, motor(s), trailer (if you selected coverage for your trailer), permanently attached equipment and portable boating equipment.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page2_s3": {
      "section_id": "page2_s3",
      "section_title": "Deductibles",
      "section_type": "prose",
      "raw_text": "All physical damage losses, regardless of loss settlement option and whether partial or total, are subject to the applicable deductible.",
      "page_range": [
        2
      ],
      "form_number": null
    }
