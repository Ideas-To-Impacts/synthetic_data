  "text_sections": {
    "page1_s1": {
      "section_id": "page1_s1",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Contact your agent for personalized service.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page1_s2": {
      "section_id": "page1_s2",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "To report a claim.",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page1_s3": {
      "section_id": "page1_s3",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "The coverages, limits and policy period shown apply only if you pay for this policy to renew. Your coverage begins on June 14, 2026 at 12:01 a.m. This policy expires on June 14, 2027 at 12:01 a.m. Your insurance policy and any policy endorsements contain a full explanation of your coverage. The policy limits shown for a vehicle may not be combined with the limits for the same coverage on another vehicle. The policy contract is form 3651 NY (08/12). The contract is modified by form 9869 NY (12/12).",
      "page_range": [
        1
      ],
      "form_number": null
    },
    "page2_s1": {
      "section_id": "page2_s1",
      "section_title": "Deductibles",
      "section_type": "prose",
      "raw_text": "All recreational vehicle physical damage losses, regardless of loss settlement option and whether partial or total, are subject to the applicable deductible.",
      "page_range": [
        2
      ],
      "form_number": null
    },
    "page3_s1": {
      "section_id": "page3_s1",
      "section_title": "PATRIOTIC INS GROUP",
      "section_type": "prose",
      "raw_text": "Contact your agent for personalized service.",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page3_s2": {
      "section_id": "page3_s2",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Your Travel Trailer Policy is Ready for Renewal - With a New Lower Rate!",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page3_s3": {
      "section_id": "page3_s3",
      "section_title": "Rate!",
      "section_type": "prose",
      "raw_text": "Thanks for being a Progressive customer since June 14, 2025; renew your policy today. Plus, your rate went down by $3!* Enclosed are your policy documents. Your current policy period ends June 14, 2026 at 12:01 a.m. This renewal offer is for the policy period June 14, 2026 through June 14, 2027. Your 12-month policy premium excluding billing fees and payment option discounts is $305.00.",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page3_s4": {
      "section_id": "page3_s4",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Please see your payment schedule.",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page3_s5": {
      "section_id": "page3_s5",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "OR try Automatic Payments! Installment payments without the work–we’ll process your payment for you and you could save! Get started at progressiveagent.com or call us at 1-800-876-5581. Please see your payment schedule. If you've scheduled a payment, it is not reflected in the amount due.",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page3_s6": {
      "section_id": "page3_s6",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Please allow five to seven days for processing. Write your policy number on your check. Make check payable to Progressive Northwestern Ins Co.",
      "page_range": [
        3
      ],
      "form_number": null
    },
    "page4_s1": {
      "section_id": "page4_s1",
      "section_title": "You can renew:",
      "section_type": "prose",
      "raw_text": "online at progressiveagent.com or on the Progressive App, by calling 1-800-876-5581, or",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s2": {
      "section_id": "page4_s2",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "by mailing your payment with this coupon.",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s3": {
      "section_id": "page4_s3",
      "section_title": "Renewal Payment Schedule",
      "section_type": "prose",
      "raw_text": "Here's a more detailed review of your payments.",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s4": {
      "section_id": "page4_s4",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "**An installment fee of $5.00 per installment is included. You may avoid installment fees by paying in full except for the current amount due.",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s5": {
      "section_id": "page4_s5",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Please make sure the value of your RV(s) reflect the current value, including all permanently attached equipment.",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s6": {
      "section_id": "page4_s6",
      "section_title": "Your online connection.",
      "section_type": "prose",
      "raw_text": "Get secure, convenient access to your policy online, anytime. Just log in at progressiveagent.com to:",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s7": {
      "section_id": "page4_s7",
      "section_title": "Get secure, convenient access to your policy online, anytime. Just log in at progressiveagent.com to:",
      "section_type": "other",
      "raw_text": "Pay a bill; Update your policy; Review your driving history; Check vehicle recalls; Report and track claims; Learn about new discounts",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page4_s8": {
      "section_id": "page4_s8",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "*This savings amount represents full-term savings and is based on a current review of your policy. If there are changes to your policy, this savings amount may change.",
      "page_range": [
        4
      ],
      "form_number": null
    },
    "page5_s1": {
      "section_id": "page5_s1",
      "section_title": "Add even more savings to your policy!",
      "section_type": "prose",
      "raw_text": "If you have more than one policy with us, you can save with Multi-Policy Discount! Give us a call to make sure you're getting all the savings you deserve.",
      "page_range": [
        5
      ],
      "form_number": null
    },
    "page5_s2": {
      "section_id": "page5_s2",
      "section_title": "Your specialized RV policy",
      "section_type": "prose",
      "raw_text": "Your RV insurance policy from Progressive provides you with unique coverages designed to protect your entire RV experience. Please contact us to review your coverages and make sure you have what you need!",
      "page_range": [
        5
      ],
      "form_number": null
    },
    "page5_s3": {
      "section_id": "page5_s3",
      "section_title": null,
      "section_type": "other",
      "raw_text": "We provide home owner-like coverage with personal liability protection.; We reimburse you for lodging expense if you cannot live in your vehicle as a result of a loss.; We provide comprehensive and collision protection when you travel to Mexico, if you purchase a sep a rate Mexican",
      "page_range": [
        5
      ],
      "form_number": null
    },
    "page5_s4": {
      "section_id": "page5_s4",
      "section_title": null,
      "section_type": "other",
      "raw_text": "We provide Fire Department Service coverage.",
      "page_range": [
        5
      ],
      "form_number": null
    },
    "page5_s5": {
      "section_id": "page5_s5",
      "section_title": null,
      "section_type": "prose",
      "raw_text": "Your policy provides you with 24 hour claims and Customer Service Support and specialized claims handling. See your policy contract and declarations page for a complete description of your coverages.",
      "page_range": [
        5
      ],
      "form_number": null
    }
  },
